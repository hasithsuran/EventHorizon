FROM docker.io/debian:12.7

ARG DEBIAN_FRONTEND=noninteractive

# Install essential build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ninja-build \
    wget \
    ca-certificates \
    openssl \
    && rm -rf /var/lib/apt/lists/*


# Install additional development tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    gdb \
    lcov \
    clang-16 \
    clang-tidy-16 \
    clang-format-16 \
    clangd-16 \
    cppcheck \ 
    iwyu \
    libfuse2 \
    appstream \
    gnupg2 \
    file \
    git \
    curl \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Expose clang-format-16 as plain `clang-format`
RUN update-alternatives --install /usr/bin/clang-format clang-format /usr/bin/clang-format-16 100

# install shared dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    qt6-base-dev \
    qt6-base-private-dev \
    qt6-networkauth-dev \
    qt6-declarative-dev \
    qt6-charts-dev \
    libgl1-mesa-dev \
    libxkbcommon-dev \
    libxcb-cursor-dev \
    qtchooser \
    libcli11-dev \
    libfmt-dev \
    libtomlplusplus-dev \
    doctest-dev \
    libzmq3-dev \
    cppzmq-dev \
    libmodbus-dev \
    zlib1g-dev \
    libexpected-dev \
    libmsgsl-dev \
    librange-v3-dev \
    libb64-dev \
    && rm -rf /var/lib/apt/lists/*

# Additional terminal tools
RUN apt-get update && apt-get -y install --no-install-recommends \
    openssh-client \
    less \
    bat \
    tree \
    nmap \
    net-tools \
    dnsutils \
    iputils-ping \
    netcat-openbsd \
    pandoc \
    && rm -rf /var/lib/apt/lists/*
    
# configure qt
RUN qtchooser --install qt6 $(which qmake6)
ENV QT_SELECT=qt6

# # bookworm-backports extras
# RUN "deb http://deb.debian.org/debian bookworm-backports main contrib non-free" >> /etc/apt/sources.list \
#     && apt-get update && apt-get -y install --no-install-recommends \
#     cmake/bookworm-backports \
#     && rm -rf /var/lib/apt/lists/*
# Install dependencies for ixwebsocket
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    cmake \
    && rm -rf /var/lib/apt/lists/*

# Build and install ixwebsocket
RUN git clone https://github.com/machinezone/IXWebSocket.git /tmp/ixwebsocket \
    && mkdir /tmp/ixwebsocket/build \
    && cd /tmp/ixwebsocket/build \
    && cmake .. -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=ON \
    && make -j$(nproc) \
    && make install \
    && cd / \
    && rm -rf /tmp/ixwebsocket

RUN apt update && apt install -y \
    linux-libc-dev \
    libc6-dev

RUN apt-get update && apt install -y can-utils iproute2


RUN apt-get update && apt-get install -y --no-install-recommends \
    qt6-svg-dev

# SimFy: Qt OpenGL modules, Assimp model loading, Mesa GL drivers
RUN apt-get update && apt-get install -y --no-install-recommends \
    libqt6opengl6-dev \
    libassimp-dev \
    zlib1g-dev \
    libgl1-mesa-dri \
    libglx-mesa0 \
    libegl1 \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y \
    doxygen \
    graphviz \
    doxygen-latex

ENV CMAKE_PREFIX_PATH=/usr/local:$CMAKE_PREFIX_PATH
ENV LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH

